# 复制为本目录下的 .env（勿提交 .env）
# 说明：docs/环境变量.md

# ── 必填（本地开发）────────────────────────────────────────
# PostgreSQL（默认 Docker，见 docker-compose.yml，宿主端口 15432）
DATABASE_URL="postgresql://app:app_dev_password@localhost:15432/user_login_admin?schema=public"

# 会话签名密钥（第 2 阶段登录 Cookie 使用，生产必须用强随机值，≥32 字符）
SESSION_SECRET="请替换为至少 32 字节的随机字符串"

# ── 可选（第 2 阶段起）────────────────────────────────────
# 站点对外 URL（生产 HTTPS；影响 Cookie Secure、邮件链接等）
# APP_URL="http://localhost:3000"

# SESSION_COOKIE_NAME="session"
# SESSION_MAX_AGE_SECONDS="604800"

# ── 第 4 阶段：找回密码邮件（Resend 或开发环境控制台输出）──
# RESEND_API_KEY=""
# MAIL_FROM="noreply@yourdomain.com"

# ── 第 6 阶段：Redis 限流（可选，本地 Docker 端口 16379）──
# REDIS_URL="redis://127.0.0.1:16379"

# ── 第 5 阶段：日志 / 监控 ───────────────────────────────
# LOG_LEVEL="info"
# SENTRY_DSN=""

# ── 种子数据（pnpm db:seed，见 docs/种子数据.md）──
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ADMIN_PASSWORD="ChangeMe_Admin123!"
# SEED_ADMIN_NAME="超级管理员"
